# Copy to backend/.env and fill in. Never commit the real .env.

# ── Database ──────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Hosted (MongoDB Atlas): copy the "Drivers" connection string from Atlas
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=resumeai
DB_NAME=resume_validator
MONGO_MAX_POOL_SIZE=50

# ── Authentication (OAuth 2.0 bearer tokens) ─────────────────────────
# Same value as REACT_APP_FIREBASE_PROJECT_ID in frontend/.env
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: also accept plain Google OAuth ID tokens from these client ids (comma-separated)
GOOGLE_OAUTH_CLIENT_IDS=
# Local development only — disables token checks entirely. The server refuses
# to start with it on a deployment (SPACE_ID set, or PORT=7860 as in the Docker image).
AUTH_DISABLED=false
# Who may sign in (comma-separated). Leave both empty to let anyone with a valid
# token sign in. When either is set, only verified emails on these lists, existing
# workspace members, and people with a pending invite get in; others get 403.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Serve /docs, /redoc and /openapi.json (off by default; keep off in production)
ENABLE_API_DOCS=false

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Resume processing throughput ─────────────────────────────────────
# Resumes processed at the same time by this process (0 = API only; run `python -m app.worker`)
RESUME_WORKERS=8
# Concurrent Gemini parse calls. Keep within your Gemini quota (free tier is very low).
PARSE_CONCURRENCY=4
PARSE_TIMEOUT_SECONDS=120
PARSE_MAX_RETRIES=4
PARSER_MAX_CHAR_BUFFER=8000
MAX_UPLOAD_MB=10
RESUMES_DIR=resumes
# Files per upload request (the frontend sends batches of 10)
MAX_FILES_PER_UPLOAD=50
# Seconds allowed for reading text out of one PDF/DOCX before the resume is marked failed
TEXT_EXTRACT_TIMEOUT_SECONDS=60

# ── Usage limits ─────────────────────────────────────────────────────
# Per workspace per UTC day; going over returns 429 until 00:00 UTC
QUOTA_RESUME_UPLOADS_PER_DAY=500
# Interview question generations (uncached) plus fact checks
QUOTA_AI_CALLS_PER_DAY=300
# Per user, separately for uploads and for AI calls; counted per process
RATE_LIMIT_PER_MINUTE=30

# ── External services ────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: Groq model for interview questions, fact checker, cover letters and GitHub analysis
# GROQ_MODEL=openai/gpt-oss-120b
GITHUB_TOKEN=
# LinkedIn lookups: Firecrawl first (fullenrich people/match, 5 credits per profile found),
# Apify only as a fallback when Firecrawl is unset, errors or finds nothing
FIRECRAWL_API_KEY=
APIFY_TOKEN=
# Portfolio checks: Behance, Dribbble, Kaggle and one personal website per candidate are read
# through Firecrawl (one scrape each per verification, about 5 credits with JSON extraction).
# Without FIRECRAWL_API_KEY they show "not checked". Set to false to switch them off.
# Stack Overflow uses the free Stack Exchange API and is not affected by this switch.
PORTFOLIO_CHECKS_ENABLED=true

# Project reviews (on demand, "Review projects" in the dossier): the candidate's deployed sites are
# visited through Firecrawl (1 credit per page: the landing page with a screenshot plus internal pages)
# and reviewed by Gemini (one call per project, uses GEMINI_API_KEY). Evidence only, never scored.
PROJECT_REVIEW_MAX_PROJECTS=3
PROJECT_REVIEW_MAX_PAGES=3
APIFY_ACTOR_ID=yZnhB5JewWf9xSmoM

# ── Team invites ─────────────────────────────────────────────────────
# Base URL of the frontend, used in invitation links
APP_URL=http://localhost:3000
# Invitation emails are sent through Composio's Gmail tool. Without a key,
# invites still work as copyable links.
COMPOSIO_API_KEY=
# Composio user id whose Gmail account is connected (and optionally the exact connected account)
COMPOSIO_USER_ID=default
COMPOSIO_GMAIL_ACCOUNT_ID=

# ── Workspace provider keys (Settings > Integrations) ─────────────────
# Lets owners/admins store their workspace's own Gemini, Groq, Firecrawl, GitHub,
# Apify or Composio key, encrypted with this Fernet key. Unset = only the keys above.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored workspace keys unreadable (the server keys apply until they are re-added).
# Also encrypts calendar, email and Slack tokens and signs their OAuth state (required for those).
PROVIDER_KEYS_SECRET=

# ── Calendar, email and Slack (Settings > Integrations > Calendar & email) ──
# Each person connects their own Google or Microsoft account to book interviews on their
# calendar and email candidates from it. A provider with an empty id/secret shows
# "Not configured on this server". Register these redirect URIs with each provider:
#   {OAUTH_REDIRECT_BASE_URL}/api/integrations/oauth/callback/google
#   {OAUTH_REDIRECT_BASE_URL}/api/integrations/oauth/callback/microsoft
#   {OAUTH_REDIRECT_BASE_URL}/api/integrations/oauth/callback/slack
# After sign-in the browser returns to {APP_URL}/settings?tab=integrations, so APP_URL must be the
# frontend's full URL (with /ResumeAI on GitHub Pages). Candidate scheduling links are {APP_URL}/schedule/<token>.
# Public URL of this backend, no trailing slash (e.g. https://<space>.hf.space or http://localhost:8000)
OAUTH_REDIRECT_BASE_URL=
# Google Cloud OAuth client (Web application). Scopes: openid, email, calendar.events, calendar.freebusy, gmail.send
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra app registration (Web platform). Delegated Graph permissions:
# offline_access, User.Read, Calendars.ReadWrite, Mail.Send
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# "common" (work and personal accounts), "organizations", or your tenant id
MICROSOFT_OAUTH_TENANT=common
# Slack app (owners/admins install it per workspace). Bot scopes: chat:write, channels:read,
# users:read, users:read.email, im:write. Without these, a workspace can still paste an
# incoming-webhook URL (channel posts only, no DMs).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
