# Copy to backend/.env and fill in. Never commit the real .env.

# ── Database ──────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Hosted (MongoDB Atlas): copy the "Drivers" connection string from Atlas
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=resumeai
DB_NAME=resume_validator
MONGO_MAX_POOL_SIZE=50

# ── Authentication (OAuth 2.0 bearer tokens) ─────────────────────────
# Same value as REACT_APP_FIREBASE_PROJECT_ID in frontend/.env
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: also accept plain Google OAuth ID tokens from these client ids (comma-separated)
GOOGLE_OAUTH_CLIENT_IDS=
# Local development only — disables token checks entirely
AUTH_DISABLED=false

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Resume processing throughput ─────────────────────────────────────
# Resumes processed at the same time by this process (0 = API only; run `python -m app.worker`)
RESUME_WORKERS=8
# Concurrent Gemini parse calls. Keep within your Gemini quota (free tier is very low).
PARSE_CONCURRENCY=4
PARSE_TIMEOUT_SECONDS=120
PARSE_MAX_RETRIES=4
PARSER_MAX_CHAR_BUFFER=8000
MAX_UPLOAD_MB=10
RESUMES_DIR=resumes

# ── External services ────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: Groq model for interview questions, fact checker and GitHub analysis
# GROQ_MODEL=openai/gpt-oss-120b
GITHUB_TOKEN=
# LinkedIn lookups: Firecrawl first (fullenrich people/match, 5 credits per profile found),
# Apify only as a fallback when Firecrawl is unset, errors or finds nothing
FIRECRAWL_API_KEY=
APIFY_TOKEN=
APIFY_ACTOR_ID=yZnhB5JewWf9xSmoM

# ── Team invites ─────────────────────────────────────────────────────
# Base URL of the frontend, used in invitation links
APP_URL=http://localhost:3000
# Invitation emails are sent through Composio's Gmail tool. Without a key,
# invites still work as copyable links.
COMPOSIO_API_KEY=
# Composio user id whose Gmail account is connected (and optionally the exact connected account)
COMPOSIO_USER_ID=default
COMPOSIO_GMAIL_ACCOUNT_ID=
USE_AGENT_SYSTEM=false
DUAL_RUN=false
