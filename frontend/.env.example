# Copy to frontend/.env and fill in from Firebase console → Project settings → Your apps.
# Vite only exposes variables prefixed with VITE_ to the browser.
# (Before the Vite migration these were named REACT_APP_* — rename them in your .env.)
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local testing only (ignored by production builds): skip sign-in.
# Pair with AUTH_DISABLED=true in backend/.env.
# VITE_AUTH_DISABLED=true
